{
  "mcpServers": {
    "rider": {
      "url": "http://127.0.0.1:64482/stream",
      "type": "http",
      "headers": {
        "IJ_MCP_LAUNCH_ORIGIN": "${IJ_MCP_LAUNCH_ORIGIN:-}"
      }
    },
    "dotnet-analysis-and-refactoring": {
      "type": "http",
      "url": "http://127.0.0.1:23751/"
    },
    "sherlock": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "sherlock-mcp"],
      "env": {}
    },
    "windows-mcp": {
      "type": "stdio",
      "command": "windows-mcp",
      "args": ["serve", "--transport", "stdio"],
      "env": {
        "ANONYMIZED_TELEMETRY": "false",
        "WINDOWS_MCP_WATCHDOG": "off"
      }
    }
  }
}