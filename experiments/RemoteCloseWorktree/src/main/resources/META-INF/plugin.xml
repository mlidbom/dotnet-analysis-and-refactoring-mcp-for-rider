<idea-plugin>
  <id>dev.magnus.royder.remote-close-worktree</id>
  <name>Royder Remote Close Worktree</name>
  <version>0.1</version>
  <idea-version since-build="263.7307.325" until-build="263.7307.325"/>
  <vendor>Royder experiments</vendor>
  <depends>com.intellij.modules.rider</depends>
  <description>Closes one solution in a shared Rider server when its worktree manager requests it.</description>
  <extensions defaultExtensionNs="com.intellij">
    <httpRequestHandler implementation="dev.magnus.royder.remotecloseworktree.CloseWorktreeService"/>
  </extensions>
</idea-plugin>
