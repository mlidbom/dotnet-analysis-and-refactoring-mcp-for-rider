<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>14</LangVersion>
    <RootNamespace>DotNetAnalysisAndRefactoringMcp</RootNamespace>
    <AssemblyName>DotNetAnalysisAndRefactoringMcp</AssemblyName>
    <!--
      The host's bytes are its identity: a tools build is served only by the host it was built against
      (dev_docs/swappable-tools.md). The SDK writes the git commit into the informational version, and Source Link
      writes it into the symbols, whose id is stamped into the assembly: that gave the host new bytes at every commit,
      and made every deploy a host change that waits for a Rider restart. With no git queries, the bytes change only
      with the code. With no symbols file, a comment or a line ending doesn't change them either: the assembly carries
      its symbols' id, which hashes the source files. Its stack traces keep the method names, not the line numbers.
    -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <!--
      MSB3277 for System.Threading.Tasks.Extensions: the ReSharper SDK 2026.3.0 pins its package at exactly 4.5.4
      (assembly 4.2.0.1), while some of its own assemblies were built against 4.6.0 (4.2.1.0). A conflict inside the
      SDK's graph, and at compile time only: the plugin ships none of these assemblies, Rider's runtime has its own.
    -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.ReSharper.SDK" Version="2026.3.0" PrivateAssets="all" />
    <!-- The version the Rider the plugin is built against ships (13.0.3 in 2026.3): the plugin runs with Rider's copy. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The SDK requires System.Security.Cryptography.Pkcs at exactly 8.0.1, which has these denial-of-service
      vulnerabilities, fixed in 8.0.2. Only the compile reads it: the plugin ships none of the SDK's assemblies, and
      runs with Rider's. Raising it to 8.0.2 only trades this warning for NU1608. Remove these once the SDK requires a
      fixed version.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>
</Project>
